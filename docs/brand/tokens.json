{
  "$schema": "morningdesk-tokens/v1",
  "name": "Morningdesk: Morning edition",
  "version": "0.1.0 (2026-11-17, brand-lead proposal, awaiting CEO)",
  "color": {
    "core": {
      "ink": { "value": "#16161A", "use": "Text, the wordmark, primary buttons" },
      "paper": { "value": "#F4F2EA", "use": "Page background (light)" },
      "highlighter": { "value": "#D4F25A", "use": "ONLY the one focal action per screen, 'new today' marks and the highlight swipe. Never text on paper, never a status, never a chart series" }
    },
    "neutral": {
      "graphite": { "value": "#46443E", "use": "Secondary text" },
      "stone": { "value": "#6B6960", "use": "Muted text, captions, source tags" },
      "rule": { "value": "#D8D4C7", "use": "Hairlines and column rules (decorative only)" }
    },
    "light": {
      "bg": "#F4F2EA",
      "surface": "#FBFAF5",
      "text": "#16161A",
      "text-secondary": "#46443E",
      "text-muted": "#6B6960",
      "rule": "#D8D4C7",
      "border-control": "#8C897E",
      "focal-bg": "#D4F25A",
      "focal-text": "#16161A",
      "focal-border": "#16161A",
      "highlight-text": "#4A6400",
      "status-pass": "#1E7A46",
      "status-fail": "#B4261A",
      "status-slipping": "#8F5400",
      "focus-ring": "#16161A"
    },
    "dark": {
      "bg": "#141418",
      "surface": "#1D1D22",
      "text": "#EFEDE4",
      "text-secondary": "#C2BFB4",
      "text-muted": "#9A978D",
      "rule": "#34343A",
      "border-control": "#6E6C66",
      "focal-bg": "#D4F25A",
      "focal-text": "#16161A",
      "focal-border": "#D4F25A",
      "highlight-text": "#C9EC52",
      "status-pass": "#5BC88A",
      "status-fail": "#FF8A7A",
      "status-slipping": "#E9A93B",
      "focus-ring": "#D4F25A"
    },
    "dataviz": {
      "note": "Categorical, fixed order, never cycled. Validated with the dataviz validator (lightness band, chroma, adjacent CVD dE >= 8 where possible, normal-vision floor, 3:1 vs surface) on 2026-11-17. Dark tritan worst pair 6.5 = legal only with direct labels, which Morningdesk charts always carry.",
      "light": ["#3355C9", "#D2552B", "#008A78", "#8A4FB0", "#977700", "#C2417A"],
      "dark": ["#6F8CF5", "#DE6A3A", "#1AA48F", "#A679D0", "#AD8A14", "#D9638F"],
      "names": ["ink blue", "vermilion", "teal", "plum", "ochre", "rose"],
      "sequential": "ink blue, light to dark",
      "diverging": "vermilion <- stone -> ink blue"
    }
  },
  "contrast_wcag": {
    "light": {
      "text/bg": 16.10, "text-secondary/bg": 8.69, "text-muted/bg": 4.91, "text-muted/surface": 5.27,
      "highlight-text/bg": 6.02, "status-pass/bg": 4.77, "status-fail/bg": 5.80, "status-slipping/bg": 5.45,
      "border-control/bg": 3.13, "ink/highlighter": 14.30, "highlighter/bg": 1.13
    },
    "dark": {
      "text/bg": 15.66, "text-secondary/bg": 9.98, "text-muted/bg": 6.29, "text-muted/surface": 5.74,
      "highlight-text/bg": 13.65, "status-pass/bg": 8.81, "status-fail/bg": 8.02, "status-slipping/bg": 8.93,
      "border-control/bg": 3.50, "ink/highlighter": 14.30, "highlighter/bg": 14.57
    },
    "rule": "All text pairs pass AA (4.5:1 body). highlighter on paper is 1.13:1, so in light mode the focal button always carries a 1.5px ink border; its label (ink on highlighter) is 14.3:1."
  },
  "font": {
    "display": { "family": "Newsreader", "license": "OFL-1.1", "source": "Google Fonts", "axes": "opsz 6-72, wght 200-800", "use": "Headlines, masthead dates, pull quotes. Weights 500-600; italics for asides" },
    "sans": { "family": "Geist", "license": "OFL-1.1", "source": "Google Fonts", "use": "UI and body" },
    "mono": { "family": "Geist Mono", "license": "OFL-1.1", "source": "Google Fonts", "use": "Every number, source tags, CLI, code, PR snippets. Tabular figures" },
    "fallback_pair": "Fraunces + Instrument Sans (both OFL)"
  },
  "type_scale": {
    "display-xl": { "font": "display", "size": 64, "line": 68, "weight": 500, "tracking": "-0.02em", "use": "Marketing hero" },
    "display-l": { "font": "display", "size": 44, "line": 50, "weight": 500, "tracking": "-0.015em" },
    "headline": { "font": "display", "size": 30, "line": 36, "weight": 600, "tracking": "-0.01em", "use": "Page titles in the app (Today, SEO)" },
    "title": { "font": "display", "size": 22, "line": 28, "weight": 600 },
    "body-l": { "font": "sans", "size": 17, "line": 27, "weight": 400 },
    "body": { "font": "sans", "size": 15, "line": 23, "weight": 400 },
    "label": { "font": "sans", "size": 13, "line": 18, "weight": 500 },
    "caption": { "font": "sans", "size": 12, "line": 16, "weight": 400 },
    "metric": { "font": "mono", "size": 28, "line": 32, "weight": 500, "features": "tnum" },
    "data": { "font": "mono", "size": 13, "line": 20, "weight": 400, "features": "tnum" },
    "source-tag": { "font": "mono", "size": 11, "line": 14, "weight": 400, "tracking": "0.02em", "use": "'GSC, 28 days' under every number" }
  },
  "ui": {
    "radius": { "control": 6, "card": 10, "tile": 14, "pill": 999 },
    "border": { "hairline": "1px rule", "control": "1px border-control", "focal": "1.5px ink (light) / none (dark)" },
    "space": [4, 8, 12, 16, 24, 32, 48, 64],
    "density": "Default rows 40px, compact 32px; touch targets 44px",
    "shadow": "None on paper. Elevation = a rule line or the surface tone, like a newspaper",
    "chart": { "line": 2, "bar_end_radius": 4, "gap": 2, "grid": "rule, dashed 2 3", "labels": "direct, mono", "legend": "always for 2+ series" }
  },
  "icon": { "grid": 24, "stroke": 1.75, "caps": "round", "joins": "round", "padding": 2, "motif": "the horizon line at y=20 where the subject sits on a desk" }
}
